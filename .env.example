# Copy to .env and fill in. Used by docker-compose.yml.
ADMIN_EMAIL=admin@bouvetbike.local
ADMIN_PASSWORD=Choose-A-Passw0rd
# Development also seeds the demo discount codes.
ASPNETCORE_ENVIRONMENT=Production
PORT=8080
# true: a new database (first start, empty volume) gets sample orders. An existing one is left alone.
SEED_SAMPLE_DATA=false
